# API Keys Configuration
# Please rename this file to .env and fill in your keys.

# ==========================================
# 1. LLM API Configuration (Choose one or more)
# ==========================================

# OpenAI / DeepSeek / 智谱 等兼容 OpenAI Chat Completions 格式的配置。
# 系统优先读取 API_KEY/API_BASE/MODEL_NAME，也兼容 OPENAI_* 别名。
API_KEY="your_api_key_here"
API_BASE="https://api.deepseek.com/v1"
MODEL_NAME="deepseek-chat"

# 兼容 OpenAI SDK 风格变量；如果上面的 API_KEY 未配置，会读取这里。
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
OPENAI_MODEL=""

# LLM 稳定输出参数
STABLE_ADVICE_MODE="1"
LLM_JSON_RETRY="3"
LLM_TIMEOUT_SECONDS="120"
LLM_MAX_TOKENS="1024"
LLM_RESPONSE_FORMAT_JSON="0"
LLM_TEMPERATURE="0.1"
LLM_TOP_P="0.2"

# 如果使用 Gemini / Google:
GOOGLE_API_KEY="your_google_api_key_here"

# 如果使用 Anthropic / Claude:
ANTHROPIC_API_KEY="your_anthropic_api_key_here"

# ==========================================
# 2. Database & Vector Store Configuration
# ==========================================
# ChromaDB persist directory (Optional, default is ./chroma_db)
CHROMA_PERSIST_DIR="./chroma_db"
# 可选：手动指定 embedding 模型；留空时优先使用 data/models 下的本地模型。
EMBEDDING_MODEL_NAME=""

# ==========================================
# 3. DL Analyst
# ==========================================
# Web/结构化建议是否启用 DL 子模块；主回测由 --no-train 控制。
ENABLE_DL_ANALYST="1"
# DL_BACKEND 默认保持原 LSTM；设为 kronos 使用 Kronos，设为 auto 时 Kronos 不可用会回退 LSTM。
DL_BACKEND="lstm"
# 默认读取项目内 third_party/Kronos；如果你单独放置 Kronos 源码，可改为绝对路径。
KRONOS_SOURCE_DIR=""
KRONOS_MODEL="NeoQuasar/Kronos-small"
KRONOS_TOKENIZER="NeoQuasar/Kronos-Tokenizer-base"
KRONOS_DEVICE="cpu"
KRONOS_MAX_CONTEXT="512"
KRONOS_PRED_LEN="5"
KRONOS_SAMPLE_COUNT="1"
KRONOS_TEMPERATURE="1.0"
KRONOS_TOP_P="0.9"

# ==========================================
# 4. Backtest Execution Assumptions
# ==========================================
# A股默认长仓模式：SELL 只表达看空/回避，不执行做空。
TRADING_ALLOW_SHORT="0"
# 单边佣金率、印花税率、单边滑点 bps，用于回测净收益估计。
TRADING_COMMISSION_RATE="0.0003"
TRADING_STAMP_DUTY_RATE="0.0005"
TRADING_SLIPPAGE_BPS="5"

# ==========================================
# 5. Web API Security
# ==========================================
# 必须显式设置；后端不会再接受默认管理员密码。
ADMIN_PASSWORD="change_me_before_running"
# 多个地址用英文逗号分隔；本地开发默认只允许这些源。
ALLOWED_ORIGINS="http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173"
# 一键启动脚本公网模式：PUBLIC_WEB=1 会监听 0.0.0.0；PUBLIC_URL 用于启动提示与外部访问地址。
# 真正跨局域网访问还需要云服务器公网 IP、域名/HTTPS 反向代理，或内网穿透服务。
PUBLIC_WEB="0"
BACKEND_HOST="127.0.0.1"
BACKEND_PORT="8000"
PUBLIC_URL=""
# CSV 上传大小限制，默认 2MB。
MAX_UPLOAD_BYTES="2097152"
# 头像上传大小限制，默认 2MB。
MAX_AVATAR_BYTES="2097152"
# 如需允许后端读取项目目录外的 CSV，设为 1；默认更安全地限制在项目目录内。
ALLOW_EXTERNAL_CSV_PATHS="0"
# 后台任务历史保留条数与子进程超时。
TASK_HISTORY_LIMIT="500"
TASK_SUBPROCESS_TIMEOUT_SECONDS="3600"
# 仅限制“生成投资建议”子进程；Kronos + 多轮 LLM/RAG 首次运行可能较慢。
ADVICE_SUBPROCESS_TIMEOUT_SECONDS="1800"
# 追问助手默认走最新建议快答，避免每次追问重建 RAG；需要强检索时再开启。
ADVICE_QA_ENABLE_RAG="0"
ADVICE_QA_USE_LLM="1"
ADVICE_QA_LLM_TIMEOUT_SECONDS="25"
ADVICE_QA_LLM_JSON_RETRY="1"
ADVICE_QA_LLM_MAX_TOKENS="700"
ADVICE_QA_LLM_RESPONSE_FORMAT_JSON="1"

# ==========================================
# 6. Market Data Providers (Optional)
# ==========================================
# AlphaVantage API Key (if you use AlphaVantage for global stocks)
ALPHA_VANTAGE_API_KEY=""
# Tushare API Token (For A-Share data)
TUSHARE_TOKEN=""
